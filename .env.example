# Local development values only. Never use them outside your machine.
# Copy to .env:  cp .env.example .env

# --- Database (Docker) ---
DB_PORT=5433
POSTGRES_USER=locale
POSTGRES_PASSWORD=locale_dev_password
POSTGRES_DB=locale
# Used by the backend in dev mode and by Prisma CLI (host port). The Docker backend overrides it with host "db".
DATABASE_URL=postgresql://locale:locale_dev_password@localhost:5433/locale
# Integration tests only. The database name must end with _test.
TEST_DATABASE_URL=postgresql://locale:locale_dev_password@localhost:5433/locale_test

# --- Backend ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Local-only admin password for the seed (min. 8 characters).
SEED_ADMIN_PASSWORD=LocalAdmin123!

# --- Auth ---
# Secure cookies need https; the local stack and dev mode run on http (Safari and Playwright WebKit drop Secure cookies there).
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
SESSION_MAX_AGE_DAYS=30
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --- Google sign-in (optional) ---
# Set all three or none; without them the login page has no Google button. The client comes from Google Cloud Console
# (type Web application, scopes openid email profile). Never commit the secret, keep it only in your .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev mode (Vite on 5173). Must be one of the Authorized redirect URIs of the client.
GOOGLE_REDIRECT_URI=
# Docker stack (nginx on 8080): http://localhost:8080/api/auth/oauth/google/callback
GOOGLE_STACK_REDIRECT_URI=

# --- Export ---
# Per backend process (pod): exports running at once, waiting in the queue, max wait and max duration of one export.
EXPORT_MAX_CONCURRENT=2
EXPORT_QUEUE_MAX=20
EXPORT_QUEUE_TIMEOUT_MS=10000
EXPORT_TIMEOUT_MS=60000
