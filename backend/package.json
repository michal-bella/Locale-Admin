{
	"name": "backend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"files": [
		"dist",
		"prisma/schema.prisma",
		"prisma/migrations",
		"prisma.config.ts"
	],
	"scripts": {
		"prisma:generate": "prisma generate",
		"dev": "prisma generate && tsx watch --env-file-if-exists=../.env src/server.ts",
		"build": "prisma generate && tsdown",
		"start": "node dist/server.js",
		"start:prod": "prisma migrate deploy && node dist/seed.js && node dist/server.js",
		"db:migrate": "prisma migrate dev && pnpm db:seed",
		"db:seed": "tsx --env-file-if-exists=../.env prisma/seed.ts",
		"db:reset": "prisma migrate reset --force && pnpm db:seed",
		"typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:integration": "prisma generate && vitest run --config vitest.integration.config.ts"
	},
	"dependencies": {
		"@locale/shared": "workspace:*",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"argon2": "0.45.1",
		"express": "5.2.1",
		"helmet": "8.3.0",
		"pg": "8.23.1",
		"pino": "10.3.1",
		"pino-http": "11.0.0",
		"prisma": "7.10.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/express": "5.0.6",
		"@types/node": "24.19.1",
		"@types/pg": "8.23.1",
		"@types/supertest": "7.2.1",
		"pino-pretty": "13.1.3",
		"supertest": "7.3.0",
		"tsdown": "0.23.0",
		"tsx": "4.23.15",
		"vitest": "5.0.3"
	}
}
