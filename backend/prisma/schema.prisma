generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ROLE {
  ADMIN
  EDITOR
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  email              String          @unique
  passwordHash       String
  role               ROLE            @default(EDITOR)
  firstName          String?
  lastName           String?
  isActive           Boolean         @default(true)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sessions           Session[]
  projectMemberships ProjectMember[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// At most one row has `isBase = true`: partial unique index `Language_isBase_key` in the `add_language` migration (Prisma cannot express it).
model Language {
  id          String   @id @default(uuid()) @db.Uuid
  tag         String   @unique
  englishName String
  nativeName  String
  flagCode    String
  isBase      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// There is one project for now (seeded); the API reads it as a singleton.
model Project {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  slug             String          @unique
  primaryColor     String          @default("#E83E8C")
  protectVariables Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  members          ProjectMember[]
}

model ProjectMember {
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}
