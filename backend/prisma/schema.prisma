generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Global role: an ADMIN works in every project without a membership, a USER only in their projects with the role of the membership.
enum ROLE {
  ADMIN
  USER
}

/// Role of a member in one project (`ProjectMember.role`), set by an ADMIN.
enum PROJECT_ROLE {
  MANAGER
  EDITOR
  VISITOR
}

enum TRANSLATIONS_VIEW {
  EXTENDED
  COMPACT
}

enum TRANSLATIONS_LAYOUT {
  COLUMNS
  STACKED
}

enum ACTIVITY_TYPE {
  PROJECT_CREATED
  PROJECT_UPDATED
  LANGUAGE_ADDED
  LANGUAGE_REMOVED
  BASE_LANGUAGE_CHANGED
  MEMBER_ADDED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  KEYS_IMPORTED
  KEY_CREATED
  KEY_UPDATED
  TRANSLATION_UPDATED
  VERSION_CREATED
  VERSION_UPDATED
  VERSION_DELETED
}

/// Lock of a `ProjectVersion`: `AUTO` locks once today is past `endsAt`, `LOCKED` and `UNLOCKED` are set by an ADMIN and win over the dates.
enum VERSION_LOCK {
  AUTO
  LOCKED
  UNLOCKED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  passwordHash       String
  role               ROLE                @default(USER)
  firstName          String?
  lastName           String?
  isActive           Boolean             @default(true)
  translationsView   TRANSLATIONS_VIEW   @default(EXTENDED)
  translationsLayout TRANSLATIONS_LAYOUT @default(COLUMNS)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime            @default(now())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  projectMemberships ProjectMember[]
  projectOrders      ProjectOrder[]
  translations       Translation[]
  activityEvents     ActivityEvent[]
  projectVersions    ProjectVersion[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

/// At most one row has `isBase = true`: partial unique index `Language_isBase_key` in the `add_language` migration (Prisma cannot express it).
/// A language of a project. Names and flag come from SUPPORTED_LANGUAGES in @locale/shared, only the tag is stored.
model ProjectLanguage {
  id           String        @id @default(uuid()) @db.Uuid
  projectId    String        @db.Uuid
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag          String
  isBase       Boolean       @default(false)
  /// Column order on the translations page (drag and drop on the Languages page); the base language is always shown first.
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  translations Translation[]

  @@unique([projectId, tag])
}

model Project {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique
  primaryColor     String            @default("#E83E8C")
  protectVariables Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          ProjectMember[]
  orders           ProjectOrder[]
  languages        ProjectLanguage[]
  translationKeys  TranslationKey[]
  activityEvents   ActivityEvent[]
  versions         ProjectVersion[]
}

/// A named date window of a project matching a release of the code (`v2.45`). `startsAt`: developers deliver the keys by this day
/// (code freeze); `endsAt`: editors finish the translations by this day and developers sync them. An ADMIN can rename it, move its dates
/// and lock or unlock it by hand; it is never deleted (keys and cells point at it with `Restrict`).
model ProjectVersion {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @db.Uuid
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  startsAt    DateTime         @db.Date
  endsAt      DateTime         @db.Date
  lock        VERSION_LOCK     @default(AUTO)
  createdById String?          @db.Uuid
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  /// Time of the last import; `null` is an empty version (no keys yet). Kept to compare late changes of an older version later.
  importedAt  DateTime?
  keys        TranslationKey[]
  events      ActivityEvent[]

  @@unique([projectId, name])
  @@index([projectId, startsAt(sort: Desc)])
}

/// Position of a project in one user's project list (drag and drop on `/`); a project without a row comes after, by name.
model ProjectOrder {
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int

  @@id([userId, projectId])
  @@index([projectId])
}

model ProjectMember {
  projectId String       @db.Uuid
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PROJECT_ROLE @default(EDITOR)
  createdAt DateTime     @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

/// Every version of a project holds its own copy of the keys: the key identity is `(versionId, namespace, name)`, so the same key
/// exists once per version and goes away with it. `projectId` is kept for project-wide reads and the cascade.
/// `namespace` is the JSON file of the key (`loc`, `paths`), `""` for none. It must be kept exactly for the export.
/// `pluralVariable` set = plural key: every value is one ICU plural message with this number variable (`serializePluralValue` in @locale/shared).
model TranslationKey {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @db.Uuid
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId      String         @db.Uuid
  version        ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  namespace      String         @default("")
  name           String
  description    String?
  pluralVariable String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  translations   Translation[]

  @@unique([versionId, namespace, name])
  @@index([projectId])
}

/// The status is derived, never stored: a missing row or `value = null` is untranslated. `""` is never written (saved as `null`).
model Translation {
  keyId              String          @db.Uuid
  key                TranslationKey  @relation(fields: [keyId], references: [id], onDelete: Cascade)
  languageId         String          @db.Uuid
  language           ProjectLanguage @relation(fields: [languageId], references: [id], onDelete: Cascade)
  value              String?
  updatedById        String?         @db.Uuid
  updatedBy          User?           @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt          DateTime        @updatedAt
  /// `true` when the value's placeholders differ from the reference (base value, else a key name with placeholders), `false` when checked
  /// and fine (always for the base language), `null` for rows the services have not computed yet (the seed fills them on start).
  placeholderWarning Boolean?

  @@id([keyId, languageId])
  @@index([languageId])
}

/// Append-only log of project changes for the dashboard, written in the same transaction as the change.
/// `payload` is a snapshot validated by `activityEventDataSchema` in @locale/shared, so it stays readable after a key, language or user is deleted.
/// `count` is the number of translations the event changed (import = written cells), the daily chart sums it.
model ActivityEvent {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @db.Uuid
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?         @db.Uuid
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Version the change belongs to (keys, cells, imports, the version itself); `null` for project-level events and after the version was deleted.
  versionId String?         @db.Uuid
  version   ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  type      ACTIVITY_TYPE
  payload   Json
  count     Int             @default(1)
  createdAt DateTime        @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([versionId])
}
