{
	"name": "frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"test": "vp test run",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"generate-icons": "svgr --config-file svgr.config.cjs --out-dir src/components/Icons src/assets/icons && eslint --fix src/components/Icons && prettier --write src/components/Icons",
		"generate-flags": "svgr --config-file svgr.flags.config.cjs --no-index --out-dir src/components/Flags src/assets/flags && eslint --fix src/components/Flags && prettier --write src/components/Flags"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "5.3.0",
		"@hookform/resolvers": "5.9.1",
		"@locale/shared": "workspace:*",
		"@mantine/core": "9.6.3",
		"@mantine/hooks": "9.6.3",
		"@mantine/notifications": "9.6.3",
		"@tanstack/react-query": "5.104.0",
		"@tanstack/react-router": "1.170.41",
		"axios": "1.20.0",
		"country-flag-icons": "1.6.20",
		"i18next": "26.4.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "7.89.0",
		"react-i18next": "17.0.15"
	},
	"devDependencies": {
		"@svgr/cli": "8.1.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"jsdom": "30.1.1",
		"tailwindcss": "4.3.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vite-plus": "1.0.0"
	}
}
